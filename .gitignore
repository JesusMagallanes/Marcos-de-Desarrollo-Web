# ─────────────────────────────────────────────────────────────
#  SECRETOS — nada de esto entra al repositorio
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# Variantes por si alguien las crea en un subdirectorio
**/.env
!**/.env.example

# Credenciales sueltas de proveedores
oauth.properties
secrets.properties
application-local.properties
application-secrets.properties

# Claves y certificados
*.pem
*.key
*.p12
*.jks
*.keystore
!**/src/test/resources/*.p12

# ─────────────────────────────────────────────────────────────
#  Build
# ─────────────────────────────────────────────────────────────
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
HELP.md

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────
#  Entornos de desarrollo
# ─────────────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
.apt_generated
.factorypath
.sts4-cache

# ─────────────────────────────────────────────────────────────
#  Sistema operativo
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── App móvil (Flutter) ──────────────────────────────────────────
# `build/` ya está arriba, pero Flutter deja más rastro fuera de ahí.
movil/.dart_tool/
movil/.flutter-plugins
movil/.flutter-plugins-dependencies
movil/*.iml
movil/android/.gradle/
movil/android/local.properties
movil/android/app/debug/
movil/android/app/profile/
movil/android/app/release/
movil/ios/Pods/
movil/ios/.symlinks/
movil/ios/Flutter/Flutter.framework
movil/ios/Flutter/Flutter.podspec
movil/ios/Flutter/Generated.xcconfig
movil/ios/Flutter/flutter_export_environment.sh

# El .env de la app NO se sube: lleva la URL del backend de cada entorno.
movil/.env
