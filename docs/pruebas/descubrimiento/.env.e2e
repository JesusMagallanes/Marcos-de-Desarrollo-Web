# Entorno AISLADO para los recorridos de descubrimiento. Solo para este E2E.
#
# Base de datos en contenedor, con volumenes propios del proyecto Compose
# `smartzone-e2e`: nunca Neon ni produccion. Todos los valores de aqui son de
# usar y tirar y solo valen dentro de esa pila; ninguno es un secreto real.
DB_URL=jdbc:postgresql://postgres:5432/smartzone
DB_USER=smartzone
DB_PASSWORD=smartzone_local
DB_MIGRACION_USER=smartzone
DB_MIGRACION_PASSWORD=smartzone_local
JWT_SECRET=e2e-descubrimiento-secreto-local-de-usar-y-tirar-0123456789abcdef
ADMIN_EMAIL=admin@smartzone.com
ADMIN_PASSWORD=E2eDescubrimiento-local-1
CORS_ORIGENES=http://localhost:4200,http://localhost:8080
FRONTEND_URL=http://localhost:4200
OAUTH_REDIRECT_BASE=http://localhost:8080
# Puertos propios, para no chocar con una pila de desarrollo levantada.
PUERTO_POSTGRES=55432
PUERTO_CATALOGO=18081
PUERTO_USUARIOS=18082
PUERTO_COMPRAS=18083
PUERTO_GATEWAY=18080
PUERTO_FRONTEND=14200
