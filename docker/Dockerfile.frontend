# Frontend Angular servido por nginx.
# El contexto de build es ./frontend.

# ── Compilación ────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /build

# pnpm viene con Node vía corepack; se fija la version del package.json para
# que la imagen use exactamente la misma que en local.
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

# Primero los manifiestos, para aprovechar la cache de Docker mientras las
# dependencias no cambien. pnpm-workspace.yaml es necesario aqui: lleva la
# lista de paquetes autorizados a compilar binarios nativos (esbuild entre
# ellos), y sin el la instalacion termina con codigo distinto de cero.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# ── Ejecución ──────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=build /build/dist/frontend/browser /usr/share/nginx/html
# nginx.conf vive en frontend/ para estar dentro del contexto de build.
COPY --from=build /build/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
