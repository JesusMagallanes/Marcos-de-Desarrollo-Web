<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite HTTP sin cifrar SOLO en compilaciones de depuración y SOLO contra
  direcciones locales.

  Desde Android 9 el tráfico en claro está bloqueado por defecto, así que sin
  esto la app no puede hablar con el backend de desarrollo y el error que se ve
  es un fallo de conexión genérico, que despista bastante.

  Este fichero vive en `src/debug/`, no en `src/main/`: una compilación de
  release no lo incluye y sigue exigiendo HTTPS, que es lo correcto cuando la
  tienda esté publicada.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- El anfitrión visto desde el emulador de Android. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Rangos de red local, para probar desde un teléfono real. -->
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
    </domain-config>
</network-security-config>
